{
  "info": {
    "_postman_id": "alqari-developer-hub",
    "name": "ALQari API",
    "description": "ALQari Document Intelligence API — Arabic-first OCR, structured OCR, layout analysis, validation, and Document Q&A.\n\nSelect the ALQari environment and set `ALQARI_API_KEY` (starts with qari_) before running requests. Paths are unversioned. The authoritative reference is https://alqari.sa/api-docs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{ALQARI_API_KEY}}",
        "type": "string"
      }
    ]
  },
  "variable": [],
  "item": [
    {
      "name": "Services",
      "item": [
        {
          "name": "Upload & OCR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.document_id) {",
                  "    pm.environment.set('DOCUMENT_ID', json.document_id);",
                  "    console.log('DOCUMENT_ID set to:', json.document_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Select a supported document file (PDF, image, DOCX, TXT, …). Max 20 MB."
                }
              ]
            },
            "url": {
              "raw": "{{ALQARI_BASE_URL}}/services/upload-ocr?mode=fast&language=auto&process_for_chat=false",
              "host": ["{{ALQARI_BASE_URL}}"],
              "path": ["services", "upload-ocr"],
              "query": [
                { "key": "skip_vlm", "value": "true", "disabled": true },
                { "key": "mode", "value": "fast", "description": "fast | premium" },
                { "key": "language", "value": "auto", "description": "auto | ar | en" },
                { "key": "department_id", "value": "", "disabled": true },
                { "key": "process_for_chat", "value": "false", "description": "Set true to enable Document Q&A later" }
              ]
            },
            "description": "Upload a file and run OCR in one step. Returns document_id, text, and output URLs."
          },
          "response": []
        }
      ]
    },
    {
      "name": "OCR Output",
      "item": [
        {
          "name": "Get OCR Text",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ALQARI_BASE_URL}}/services/ocr-output/{{DOCUMENT_ID}}/text",
              "host": ["{{ALQARI_BASE_URL}}"],
              "path": ["services", "ocr-output", "{{DOCUMENT_ID}}", "text"]
            },
            "description": "Retrieve the full extracted text as plain text."
          },
          "response": []
        },
        {
          "name": "Get Structured OCR",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ALQARI_BASE_URL}}/services/ocr-output/{{DOCUMENT_ID}}/ocr",
              "host": ["{{ALQARI_BASE_URL}}"],
              "path": ["services", "ocr-output", "{{DOCUMENT_ID}}", "ocr"]
            },
            "description": "Retrieve structured OCR regions (text, confidence, 4-point bbox, page)."
          },
          "response": []
        },
        {
          "name": "Get Layout Analysis",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ALQARI_BASE_URL}}/services/ocr-output/{{DOCUMENT_ID}}/layout",
              "host": ["{{ALQARI_BASE_URL}}"],
              "path": ["services", "ocr-output", "{{DOCUMENT_ID}}", "layout"]
            },
            "description": "Retrieve layout analysis (blocks, tables, figures, page sizes)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Validation",
      "item": [
        {
          "name": "Validate Document",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{ALQARI_BASE_URL}}/services/ai-validate?document_id={{DOCUMENT_ID}}&rules_text=1. The invoice total must equal the sum of line items.",
              "host": ["{{ALQARI_BASE_URL}}"],
              "path": ["services", "ai-validate"],
              "query": [
                { "key": "document_id", "value": "{{DOCUMENT_ID}}" },
                { "key": "rules_text", "value": "1. The invoice total must equal the sum of line items." }
              ]
            },
            "description": "Run rule-based validation against an already-processed document."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Document Q&A",
      "item": [
        {
          "name": "Chat with Document",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"ما إجمالي الفاتورة؟\"\n}"
            },
            "url": {
              "raw": "{{ALQARI_BASE_URL}}/services/chat/{{DOCUMENT_ID}}",
              "host": ["{{ALQARI_BASE_URL}}"],
              "path": ["services", "chat", "{{DOCUMENT_ID}}"]
            },
            "description": "Ask a question about a document. The document must be uploaded with process_for_chat=true."
          },
          "response": []
        }
      ]
    }
  ]
}
