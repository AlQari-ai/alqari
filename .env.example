# ALQari API Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Your ALQari API key (starts with qari_) — generate one from your dashboard
ALQARI_API_KEY=qari_your_api_key_here

# Base URL (production). Paths are unversioned (no /v1).
ALQARI_BASE_URL=https://api.alqari.sa

# Optional: default language hint for OCR requests (auto | ar | en)
ALQARI_DEFAULT_LANGUAGE=auto

# Path to a local sample image/PDF for upload examples
# Copy assets/sample-ar-handwriting.jpg to your working directory or point to any image/PDF
SAMPLE_FILE=assets/sample-ar-handwriting.jpg
